name = input("Enter your name: ")
bal = int(input("Enter your current balance: "))
print("Hi " + name)

while True:
    #print(f"\nYour current balance is: {bal}")
    print("Select your action:")
    print("1 - Withdraw")
    print("2 - Deposit")
    print("3 - Check Balance")
    print("4 - Exit")

    action = input("Enter your choice (1/2/3/4): ")

    if action == "1":
        withdraw = int(input("Enter withdrawal amount: "))
        if withdraw > bal:
            print("Not sufficient balance.")
        else:
            bal -= withdraw
            print(f"Withdrawal successful. Remaining balance: {bal}")

    elif action == "2":
        deposit = int(input("Enter deposit amount: "))
        bal += deposit
        print(f"Deposit successful. New balance: {bal}")

    elif action == "3":
        print(f"Your current balance is: {bal}")

    elif action == "4":
        print("Thank you for using our service. Goodbye!")
        break

    else:
        print("Invalid choice. Please select a valid option.")
